# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

menu "Motor Control"

config RLS_PARAMETER_ESTIMATION
	bool "Enable RLS online parameter estimation"
	default n
	help
	  Enable Recursive Least Squares (RLS) online parameter estimation
	  for motor inductance and resistance. This feature uses PRBS excitation
	  and real-time RLS filtering to estimate motor parameters during operation.
	  Currently not functioning - disabled for future development.

config ENCODER_MAGNET_CHECK_ON_ARM
	bool "Block arm when AEAT-9955 reports MHI/MLO alarm"
	default n
	help
	  If enabled, `motor arm` reads AEAT-9955 error status register 0x29
	  and rejects arming when MHI or MLO alarm bits are set.
	  Keep disabled for bring-up if magnet alignment/strength is not finalized.

config MOTOR_CURRENT_DECOUPLING
	bool "Enable d/q decoupling and back-EMF feedforward"
	default n
	help
	  Adds model-based feedforward terms to the d-axis and q-axis current loops:
	  vd_ff = -omega_e * Lq * iq and
	  vq_ff =  omega_e * (Ld * id + psi_f).

config MOTOR_VELOCITY_NOTCH_FILTER
	bool "Enable velocity feedback notch filter"
	default n
	help
	  Enables a second-order notch filter on measured mechanical speed
	  before velocity error computation.

config MOTOR_VELOCITY_NOTCH_FREQ_HZ
	int "Velocity notch center frequency (Hz)"
	default 300
	range 1 5000
	depends on MOTOR_VELOCITY_NOTCH_FILTER
	help
	  Center frequency of the velocity notch filter.

config MOTOR_VELOCITY_NOTCH_Q_MILLI
	int "Velocity notch Q x1000"
	default 2000
	range 100 20000
	depends on MOTOR_VELOCITY_NOTCH_FILTER
	help
	  Notch filter quality factor scaled by 1000.
	  Example: 2000 => Q = 2.0.

config MOTOR_OUTER_LOOP_MPR
	bool "Use model-predictive outer loops (velocity + position)"
	default y
	help
	  Enables SpinTAC-style model predictive regulators for the velocity and
	  position outer loops. Disable to use legacy PI outer loops.

config MOTOR_ISR_SANITY_CHECKS
	bool "Enable runtime finite/sanity checks in ISR control path"
	default y
	help
	  Enables finite-value guards in the fast ISR control path.
	  Keep enabled during bring-up/debugging for fault containment.
	  Disable in performance-focused builds to remove redundant hot-path checks
	  after the signal chain and configuration are validated.

endmenu
