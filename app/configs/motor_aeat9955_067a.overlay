/*
 * Motor profile overlay for AEAT-9955 encoder setup (0.67 A class motor).
 *
 * Usage:
 *   west build ... -- \
 *     -DDTC_OVERLAY_FILE="app/boards/smartstepper_v2.overlay;app/configs/motor_aeat9955_067a.overlay"
 *
 * Notes:
 * - This mirrors the current AEAT-based motor configuration from
 *   smartstepper_v2 overlay so it can be selected explicitly as a profile.
 * - Keep board pin/peripheral wiring in the board overlay.
 */

/ {
	aliases {
		/* Use AEAT-9955 sensor for control-loop encoder input. */
		encoder1 = &aeat9955;
	};

	user_parameters: user_parameters {
		compatible = "rubus,user-parameters";
		nominal_voltage-mv = <24000>;
		pwm-frequency-hz = <20000>;
		control-loop-frequency-hz = <20000>;
		current-loop-bandwidth-hz = <150>;
		offset-pole-hz = <300>;
		encoder-direction-sign = <(-1)>;
		align-current-ma = <67>;
		align-duration-ms = <100>;
		brake-current-ma = <1000>;
		max-modulation-index-mpu = <950>;
		roverl-est-current-ma = <100>;
		roverl-est-freq-hz = <250>;
		roverl-est-settling-ms = <50>;
		roverl-est-duration-ms = <5000>;
		rs-est-current-ma = <100>;
		rs-est-rampup-ms = <1000>;
		rs-est-duration-ms = <1000>;
		rls-excitation-current-ma = <100>;
		velocity-max-hz = <50>;
		velocity-max-accel-hz-per-s = <10>;
		velocity-initial-hz = <0>;
	};

	motor_parameters: motor_parameters {
		compatible = "rubus,motor-parameters";
		inductance-d-uh = <3400>;
		inductance-q-uh = <3400>;
		resistance-mohms = <5600>;
		flux_linkage_uvphz = <17675>;
		pole-pairs = <50>;
		max-current-ma = <670>;
		inertia-mgcm2 = <9000>;
		max-speed-hz = <50>;
	};

	fault_detection: fault_detection {
		compatible = "rubus,fault-detection";
		encoder-fault-threshold = <100>;
		/* 120% of 0.67 A current limit. */
		overcurrent-threshold-ma = <800>;
	};
};

&spi3 {
	fifo-enable;
	status = "okay";

	aeat9955: aeat9955@0 {
		compatible = "brcm,aeat-9955";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(4)>;
		status = "okay";
	};
};
